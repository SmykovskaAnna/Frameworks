{% extends 'base.html.twig' %}

{% block title %}Ticket index    <p>Сторінка {{ page }} з {{ totalPages }}</p>
    {% if page > 1 %}<a href="{{ path('app_ticket_index', filters|merge({'page': page - 1, 'itemsPerPage': itemsPerPage})) }}">Попередня</a>{% endif %}
    {% if page < totalPages %}<a href="{{ path('app_ticket_index', filters|merge({'page': page + 1, 'itemsPerPage': itemsPerPage})) }}">Наступна</a>{% endif %}
{% endblock %}

{% block body %}
    <h1>Ticket index</h1>

    <form method="get" style="margin-bottom: 1em">
        <label>id: <input name="id" value="{{ filters.id|default('') }}"></label>
        <label>purchaseDate: <input name="purchaseDate" value="{{ filters.purchaseDate|default('') }}"></label>
        <label>price: <input name="price" value="{{ filters.price|default('') }}"></label>
        <label>ticketType: <input name="ticketType" value="{{ filters.ticketType|default('') }}"></label>
        <label>visitorId: <input name="visitorId" value="{{ filters.visitorId|default('') }}"></label>
        <label>exhibitionId: <input name="exhibitionId" value="{{ filters.exhibitionId|default('') }}"></label>
        <label>itemsPerPage: <input type="number" name="itemsPerPage" min="1" max="100" value="{{ itemsPerPage }}"></label>
        <button type="submit">Фільтрувати</button> <a href="{{ path('app_ticket_index') }}">Очистити</a>
    </form>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>PurchaseDate</th>
                <th>Price</th>
                <th>TicketType</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for ticket in tickets %}
            <tr>
                <td>{{ ticket.id }}</td>
                <td>{{ ticket.purchaseDate ? ticket.purchaseDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ ticket.price }}</td>
                <td>{{ ticket.ticketType }}</td>
                <td>
                
    <a href="{{ path('app_ticket_show', {'id': ticket.id}) }}">show</a>
                    <a href="{{ path('app_ticket_edit', {'id': ticket.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_ticket_new') }}">Create new</a>
    <p>Сторінка {{ page }} з {{ totalPages }}</p>
    {% if page > 1 %}<a href="{{ path('app_ticket_index', filters|merge({'page': page - 1, 'itemsPerPage': itemsPerPage})) }}">Попередня</a>{% endif %}
    {% if page < totalPages %}<a href="{{ path('app_ticket_index', filters|merge({'page': page + 1, 'itemsPerPage': itemsPerPage})) }}">Наступна</a>{% endif %}
{% endblock %}
