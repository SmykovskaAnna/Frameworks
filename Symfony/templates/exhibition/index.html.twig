{% extends 'base.html.twig' %}

{% block title %}Exhibition index    <p>Сторінка {{ page }} з {{ totalPages }}</p>
    {% if page > 1 %}<a href="{{ path('app_exhibition_index', filters|merge({'page': page - 1, 'itemsPerPage': itemsPerPage})) }}">Попередня</a>{% endif %}
    {% if page < totalPages %}<a href="{{ path('app_exhibition_index', filters|merge({'page': page + 1, 'itemsPerPage': itemsPerPage})) }}">Наступна</a>{% endif %}
{% endblock %}

{% block body %}
    <h1>Exhibition index</h1>

    <form method="get" style="margin-bottom: 1em">
        <label>id: <input name="id" value="{{ filters.id|default('') }}"></label>
        <label>name: <input name="name" value="{{ filters.name|default('') }}"></label>
        <label>description: <input name="description" value="{{ filters.description|default('') }}"></label>
        <label>startDate: <input name="startDate" value="{{ filters.startDate|default('') }}"></label>
        <label>endDate: <input name="endDate" value="{{ filters.endDate|default('') }}"></label>
        <label>itemsPerPage: <input type="number" name="itemsPerPage" min="1" max="100" value="{{ itemsPerPage }}"></label>
        <button type="submit">Фільтрувати</button> <a href="{{ path('app_exhibition_index') }}">Очистити</a>
    </form>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>StartDate</th>
                <th>EndDate</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for exhibition in exhibitions %}
            <tr>
                <td>{{ exhibition.id }}</td>
                <td>{{ exhibition.name }}</td>
                <td>{{ exhibition.description }}</td>
                <td>{{ exhibition.startDate ? exhibition.startDate|date('Y-m-d') : '' }}</td>
                <td>{{ exhibition.endDate ? exhibition.endDate|date('Y-m-d') : '' }}</td>
                <td>
                
    <a href="{{ path('app_exhibition_show', {'id': exhibition.id}) }}">show</a>
                    <a href="{{ path('app_exhibition_edit', {'id': exhibition.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_exhibition_new') }}">Create new</a>
    <p>Сторінка {{ page }} з {{ totalPages }}</p>
    {% if page > 1 %}<a href="{{ path('app_exhibition_index', filters|merge({'page': page - 1, 'itemsPerPage': itemsPerPage})) }}">Попередня</a>{% endif %}
    {% if page < totalPages %}<a href="{{ path('app_exhibition_index', filters|merge({'page': page + 1, 'itemsPerPage': itemsPerPage})) }}">Наступна</a>{% endif %}
{% endblock %}
