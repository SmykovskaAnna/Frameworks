{% extends 'base.html.twig' %}

{% block title %}Exhibit{% endblock %}

{% block body %}
    <h1>Exhibit</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ exhibit.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ exhibit.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ exhibit.description }}</td>
            </tr>
            <tr>
                <th>Author</th>
                <td>{{ exhibit.author }}</td>
            </tr>
            <tr>
                <th>CreationDate</th>
                <td>{{ exhibit.creationDate ? exhibit.creationDate|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_exhibit_index') }}">back to list</a>

    <a href="{{ path('app_exhibit_edit', {'id': exhibit.id}) }}">edit</a>

    {{ include('exhibit/_delete_form.html.twig') }}
{% endblock %}
