{% extends 'base.html.twig' %}

{% block title %}Exhibit index    <p>Сторінка {{ page }} з {{ totalPages }}</p>
    {% if page > 1 %}<a href="{{ path('app_exhibit_index', filters|merge({'page': page - 1, 'itemsPerPage': itemsPerPage})) }}">Попередня</a>{% endif %}
    {% if page < totalPages %}<a href="{{ path('app_exhibit_index', filters|merge({'page': page + 1, 'itemsPerPage': itemsPerPage})) }}">Наступна</a>{% endif %}
{% endblock %}

{% block body %}
    <h1>Exhibit index</h1>

    <form method="get" style="margin-bottom: 1em">
        <label>id: <input name="id" value="{{ filters.id|default('') }}"></label>
        <label>name: <input name="name" value="{{ filters.name|default('') }}"></label>
        <label>description: <input name="description" value="{{ filters.description|default('') }}"></label>
        <label>author: <input name="author" value="{{ filters.author|default('') }}"></label>
        <label>creationDate: <input name="creationDate" value="{{ filters.creationDate|default('') }}"></label>
        <label>itemsPerPage: <input type="number" name="itemsPerPage" min="1" max="100" value="{{ itemsPerPage }}"></label>
        <button type="submit">Фільтрувати</button> <a href="{{ path('app_exhibit_index') }}">Очистити</a>
    </form>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>Author</th>
                <th>CreationDate</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for exhibit in exhibits %}
            <tr>
                <td>{{ exhibit.id }}</td>
                <td>{{ exhibit.name }}</td>
                <td>{{ exhibit.description }}</td>
                <td>{{ exhibit.author }}</td>
                <td>{{ exhibit.creationDate ? exhibit.creationDate|date('Y-m-d') : '' }}</td>
                <td>
                
    <a href="{{ path('app_exhibit_show', {'id': exhibit.id}) }}">show</a>
                    <a href="{{ path('app_exhibit_edit', {'id': exhibit.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_exhibit_new') }}">Create new</a>
    <p>Сторінка {{ page }} з {{ totalPages }}</p>
    {% if page > 1 %}<a href="{{ path('app_exhibit_index', filters|merge({'page': page - 1, 'itemsPerPage': itemsPerPage})) }}">Попередня</a>{% endif %}
    {% if page < totalPages %}<a href="{{ path('app_exhibit_index', filters|merge({'page': page + 1, 'itemsPerPage': itemsPerPage})) }}">Наступна</a>{% endif %}
{% endblock %}
